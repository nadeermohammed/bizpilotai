# BizPilot AI Environment Variables Configuration
# Copy this file to '.env' and fill in your keys.

# Gemini API Key (Required for live AI features)
# Get one free here: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Credentials (Required for cloud database sync)
# Create a free project here: https://supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
